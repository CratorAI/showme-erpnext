{
	"manifest_version": 3,
	"name": "Crator for ERPNext",
	"version": "0.1.0",
	"description": "An AI copilot inside your ERPNext: it does things on screen with a visible cursor, talks you through it, and can adjust your setup with your approval.",
	"permissions": ["storage", "scripting", "tabs", "activeTab"],
	"host_permissions": ["https://api.anthropic.com/*", "https://api.openai.com/*"],
	"optional_host_permissions": ["https://*/*", "http://*/*"],
	"background": { "service_worker": "background.js", "type": "module" },
	"action": {
		"default_title": "Crator for ERPNext",
		"default_popup": "popup.html",
		"default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
	},
	"options_page": "options.html",
	"icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
