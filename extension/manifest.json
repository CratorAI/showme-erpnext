{
	"manifest_version": 3,
	"name": "ShowMe for ERPNext",
	"version": "0.1.0",
	"description": "The AI guide for people self-implementing ERPNext: ask in your own words, and it shows you on your own screen.",
	"permissions": ["storage", "unlimitedStorage", "scripting", "tabs", "activeTab"],
	"host_permissions": ["https://api.anthropic.com/*", "https://api.openai.com/*"],
	"optional_host_permissions": ["https://*/*", "http://*/*"],
	"background": { "service_worker": "background.js", "type": "module" },
	"action": {
		"default_title": "ShowMe for ERPNext",
		"default_popup": "popup.html",
		"default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
	},
	"options_page": "options.html",
	"icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
